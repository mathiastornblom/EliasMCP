# ELIAS MCP Server — Example environment variables
# Copy to .env and fill in your values (never commit .env)

ELIAS_BASE_URL=https://elias.example.com:22130/api
ELIAS_USERNAME=admin
ELIAS_PASSWORD=
ELIAS_DOMAIN=
ELIAS_IGNORE_TLS=false
ELIAS_REQUEST_TIMEOUT_MS=30000

# Container used for destructive tests (integration tests only touch this)
ELIAS_TEST_CONTAINER=mcp-test
